# конфигурационный файл. сюда выносятся все основные переменные. (он не загружается в git)
# ==== FastAPI ====
# переменные для подключения к основной БД
DB_HOST=db
DB_PORT=5432
DB_NAME=infoRUN_Postgres
DB_USER=sa
DB_PASS=1234


# переменные для подключения к БД с логами
DB_HOST_LOG=db
DB_PORT_LOG=
DB_NAME_LOG=infoRUN
DB_USER_LOG=sa
DB_PASS_LOG=1234
# JWT токены
SECRET_KEY=secret_key_olezhka           # ключ
ALGORITHM=HS256                         # алгоритм шифрования
ACCESS_TOKEN_EXPIRE_MINUTES=3600        # время действия токена



LOG_DIR =logs                          # папки c логами
#ARCHIVE_LOG_DIR =                       # папка с архивами логов (по умолчанию logs/archive)
LOG_FILE=app.log
CELERY_LOG_FILE = celery.log
KAFKA_LOG_FILE = kafka.log
UPLOAD_IMAGE_DIR = images       # папка для самих заданий
UPLOAD_SOLUTION_DIR = solutions # папка для решения
UPLOAD_FILES_DIR = files        # папка для дополнительных файлов
UPLOAD_STUDENTS_IMAGE_DIR = StudentSolutions # папка для решения студентов
TEMPLATES_DIR = templates
LOG_LEVEL=INFO


# ==== Kafka ====
# подключение к серверу kafka, и для consumer и для producer
KAFKA_BOOTSTRAP_SERVERS=10.0.2.4:9092
# KAFKA_TOPIC_LOGS=students.actions Не использую, нет смысла
#KAFKA_TOPIC_EMAIL=email.notifications          (пока не используется)
#KAFKA_TOPIC_TELEGRAM=telegram.notifications    (пока не используется)

REDIS_BROKER_URL =redis://10.0.2.4:6379/0
REDIS_RESULT_BACKEND =redis://10.0.2.4:6379/1

# ==== Email ====
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=Beginin-Oleg@yandex.ru
SMTP_PASS=cfmpiikeadenshlf
EMAIL_FROM=Beginin-Oleg@yandex.ru

